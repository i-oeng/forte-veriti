# Copy to ~/forte/forte.env and set a real key (python3 -c "import secrets; print(secrets.token_urlsafe(32))")
FORTE_HOME=/home/xixi/forte
FORTE_API_KEY=change-me
FORTE_MAX_PARALLEL_JOBS=4
FORTE_JOB_DEADLINE_SEC=270
FORTE_VLM_BASE_URL=http://127.0.0.1:8100/v1
FORTE_VLM_MODEL=vlm
FORTE_DETECTOR=small
FORTE_PERCEPTION_FPS=5
FORTE_VIOLATION_THRESHOLD=0.5
VLLM_GPU_UTIL=0.70
FORTE_VLM_WEIGHTS=Qwen3.5-4B-AWQ-4bit
VLLM_MAX_SEQS=12
VLLM_BATCHED_TOKENS=2048
FORTE_OUTPUT_LANG=ru
FORTE_KEEP_SOURCE=0
# no internet needed once the weights are on disk (case section 7, portability)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
# 24 GB GPU (Runpod RTX 4090 / L4) with Qwen3.5-9B FP8:
#   FORTE_VLM_WEIGHTS=Qwen3.5-9B-FP8-dynamic  VLLM_GPU_UTIL=0.72  VLLM_MAX_SEQS=16  VLLM_BATCHED_TOKENS=4096
#   FORTE_VLM_FRAME_LONG_SIDE=768
